coverage
*.lcov

# Extension signing material. `Pack extension` in chrome://extensions drops a
# .pem private key next to the .crx — publishing that key lets anyone ship an
# update for the extension.
*.pem
*.crx
*.xpi

# Local secrets. WXT loads .env files at build time.
.env
.env.*
!.env.example

